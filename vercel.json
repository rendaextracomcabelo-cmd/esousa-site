{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/agenteisa",
      "destination": "https://agente-isa.vercel.app/"
    },
    {
      "source": "/agenteisa/:path*",
      "destination": "https://agente-isa.vercel.app/:path*"
    },
    {
      "source": "/agentedetopobelaisa",
      "destination": "https://belaisa.vercel.app/"
    },
    {
      "source": "/agentedetopobelaisa/:path*",
      "destination": "https://belaisa.vercel.app/:path*"
    },
    {
      "source": "/hero-banner.png",
      "destination": "https://belaisa.vercel.app/hero-banner.png"
    },
    {
      "source": "/isapainel",
      "destination": "https://salao.esousa.com.br/isapainel"
    },
    {
      "source": "/isapainel/:path*",
      "destination": "https://salao.esousa.com.br/isapainel/:path*"
    }
  ],
  "headers": [
    {
      "source": "/bio",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/bio/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/isapainel",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/isapainel/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
